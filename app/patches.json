{
 "code_patches": [
  {
   "name": "アプリIDを分ける（本家版と共存）",
   "file": "src/PKForge.App/PKForge.App.csproj",
   "find": "<ApplicationId>org\\.pkforge\\.shurt</ApplicationId>",
   "replace": "<ApplicationId>org.pkforge.shurt.dex</ApplicationId>",
   "required": true,
   "min": 1
  },
  {
   "name": "アプリ名",
   "file": "src/PKForge.App/PKForge.App.csproj",
   "find": "<ApplicationTitle>PKForge Personal</ApplicationTitle>",
   "replace": "<ApplicationTitle>PKForge Dex</ApplicationTitle>",
   "required": true,
   "min": 1
  },
  {
   "name": "アイコン・スプラッシュの背景色",
   "file": "src/PKForge.App/PKForge.App.csproj",
   "find": "(<Maui(?:Icon|SplashScreen) Include=\"[^\"]+\" Color=\")#[0-9A-Fa-f]{6}\"",
   "replace": "\\g<1>#0E0B0C\"",
   "required": true,
   "min": 2
  },
  {
   "name": "アプリ内アップデートの確認先をこのリポジトリに",
   "file": "src/PKForge.App/Services/AppUpdateService.cs",
   "find": "repos/Shurt/PKForge/releases/latest",
   "replace": "repos/${repo}/releases/latest",
   "required": true,
   "min": 1
  },
  {
   "name": "起動時に表示言語を設定（ポケモン名なども）",
   "file": "src/PKForge.App/MauiProgram.cs",
   "find": "(public static MauiApp CreateMauiApp\\(\\)\\s*\\{)",
   "replace": "\\1\\n        global::PKForgeI18n.LangSetup.Init();",
   "required": true,
   "min": 1
  },
  {
   "name": "ポケモン名を表示言語で",
   "file": "src/PKForge.Engine/**/*.cs",
   "find": "(SpeciesName\\.GetSpeciesName\\([^;]*?, \\(int\\))LanguageID\\.English\\)",
   "replace": "\\1GameLanguage.GetLanguage(GameInfo.CurrentLanguage))",
   "required": false,
   "min": 1
  },
  {
   "name": "タイプ名・とくせい名を表示言語で",
   "file": "src/PKForge.Engine/SaveEngineSession.cs",
   "find": "GameInfo\\.GetStrings\\(\"en\"\\)\\.(Types|abilitylist)",
   "replace": "GameInfo.Strings.\\1",
   "required": false,
   "min": 1
  },
  {
   "name": "設定メニューに「言語」を追加",
   "file": "src/PKForge.App/Views/HomePage.cs",
   "find": "(\\n(\\s*)new PadOption\\([^\\n]*IconPath: \"music\"\\),)",
   "replace": "\\n\\2new PadOption(global::PKForgeI18n.LangSetup.MenuText, IconPath: \"gears\"),\\1",
   "required": false,
   "min": 1
  },
  {
   "name": "「言語」を選んだときの処理",
   "file": "src/PKForge.App/Views/HomePage.cs",
   "find": "(if \\(choice == hiddenOption\\) \\{ await ShowHiddenSavesAsync\\(\\); return; \\})",
   "replace": "\\1\\n        if (choice == global::PKForgeI18n.LangSetup.MenuText) { await global::PKForgeI18n.LangSetup.ShowPickerAsync(_hostGrid); return; }",
   "required": false,
   "min": 1
  },
